<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="robots" content="noindex, nofollow">
<title>Send text</title>
<style>
  :root {
    --bg: #f3f6fb;
    --ink: #13233f;
    --muted: #5a6783;
    --sapphire: #0f52ba;
    --sapphire-press: #0b3f8f;
    --card: #ffffff;
    --line: #d7dfec;
    color-scheme: light;
    box-sizing: border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0d1626;
      --ink: #e8eefb;
      --muted: #9fb0d0;
      --sapphire: #3b7be0;
      --sapphire-press: #2c63bd;
      --card: #16223a;
      --line: #2a3a5c;
      color-scheme: dark;
    }
  }
  *, *::before, *::after { box-sizing: inherit; }
  html, body { height: 100%; margin: 0; }
  body {
    background: var(--bg);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  main {
    width: 100%;
    max-width: 440px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 28px 22px;
  }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .to { font-size: 28px; font-weight: 700; margin: 0 0 18px; letter-spacing: 0.5px; }
  .label { font-size: 14px; color: var(--muted); margin: 0 0 6px; }
  .msg {
    white-space: pre-wrap;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 14px;
    font-size: 16px;
    line-height: 1.45;
    margin: 0 0 22px;
    max-height: 40vh;
    overflow-y: auto;
  }
  a.send {
    display: block;
    text-align: center;
    background: var(--sapphire);
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    text-decoration: none;
    padding: 18px;
    border-radius: 14px;
  }
  a.send:active { background: var(--sapphire-press); }
  a.send:focus-visible { outline: 3px solid var(--ink); outline-offset: 3px; }
  .error { color: #c0392b; font-size: 16px; }
</style>
</head>
<body>
<main id="app">
  <p class="error">This link is missing the phone number.</p>
</main>
<script>
  (function () {
    // EDIT HERE: your confirmation text. Replace [X] and [Y] with your carrier numbers.
    var DEFAULT_MESSAGE =
      "Hi, this is Rose with Sapphire Insurance Group. Thank you for requesting Medicare information. I will call you shortly from this number. Reply STOP to opt out.\n\n" +
      "We do not offer every plan available in your area. Currently we represent [X] organizations which offer [Y] products in your area. Please contact Medicare.gov or 1-800-MEDICARE to get information on all of your options.";

    var params = new URLSearchParams(window.location.search);
    var rawTo = params.get("to") || "";
    var body = params.get("body") || DEFAULT_MESSAGE;

    var digits = rawTo.replace(/[^0-9]/g, "");
    if (digits.length === 10) digits = "1" + digits;
    if (digits.length < 11) return;
    var to = "+" + digits;

    var pretty = digits.length === 11
      ? "(" + digits.substr(1, 3) + ") " + digits.substr(4, 3) + "-" + digits.substr(7, 4)
      : to;

    var smsUrl = "sms:" + to + (body ? "&body=" + encodeURIComponent(body) : "");

    var app = document.getElementById("app");
    app.innerHTML = "";

    var h1 = document.createElement("h1");
    h1.textContent = "Send text to";
    var num = document.createElement("p");
    num.className = "to";
    num.textContent = pretty;
    app.appendChild(h1);
    app.appendChild(num);

    if (body) {
      var lbl = document.createElement("p");
      lbl.className = "label";
      lbl.textContent = "Message";
      var msg = document.createElement("p");
      msg.className = "msg";
      msg.textContent = body;
      app.appendChild(lbl);
      app.appendChild(msg);
    }

    var btn = document.createElement("a");
    btn.className = "send";
    btn.href = smsUrl;
    btn.textContent = "Open in Messages";
    app.appendChild(btn);
  })();
</script>
</body>
</html>
